{
  "name": "design-basket",
  "private": true,
  "version": "0.0.0",
  "description": "Collect design references in folders and export a design pack (brief, tokens, images) that Claude Code can follow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Harry-Verdeflor/design-basket.git"
  },
  "keywords": [
    "design",
    "design-tokens",
    "moodboard",
    "claude",
    "claude-code",
    "react",
    "indexeddb"
  ],
  "type": "module",
  "scripts": {
